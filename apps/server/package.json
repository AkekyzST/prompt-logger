{
  "name": "@prompt-logger/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hono server: ingest, SSE, auth, mounts SvelteKit.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/lib/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "arctic": "^2.2.0",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "oslo": "^1.2.0",
    "pino": "^9.5.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.14.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
