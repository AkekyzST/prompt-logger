# ==============================================================================
# Prompt Logger — environment configuration
# Copy this file to `.env` and fill in the values.
# Never commit `.env`.
# ==============================================================================

# --- Core ---------------------------------------------------------------------
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://prompts.example.com
DATABASE_PATH=/data/prompts.db

# --- Ingest -------------------------------------------------------------------
# Long random string shared with every client hook. Rotate by updating here and
# in each hook's ~/.config/prompt-logger/config.env.
# Generate: `openssl rand -hex 32`
INGEST_TOKEN=
INGEST_RATE_LIMIT_PER_MIN=60
INGEST_MAX_BODY_KB=256

# --- OIDC (generic — any provider with .well-known/openid-configuration) ------
# Examples:
#   Google:     https://accounts.google.com
#   GitHub:     (use a dedicated OIDC wrapper; GitHub is OAuth2-only natively)
#   Authentik:  https://auth.example.com/application/o/prompt-logger/
#   Keycloak:   https://auth.example.com/realms/main
#   Zitadel:    https://auth.example.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://prompts.example.com/auth/callback
OIDC_SCOPES=openid profile email

# --- Admin bootstrap ----------------------------------------------------------
# Comma-separated. The first user whose email matches one of these on login
# becomes admin. Everyone else starts as 'viewer' with zero access until you
# grant sessions or class codes.
ADMIN_EMAILS=you@example.com

# --- Sessions -----------------------------------------------------------------
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=pl_sess

# --- Redaction ----------------------------------------------------------------
# Extra patterns as JSON array of {name, regex, replace}.
# REDACTION_EXTRA_PATTERNS=[{"name":"internal-token","regex":"INT_[A-Z0-9]{32}","replace":"[REDACTED:internal]"}]
REDACTION_EXTRA_PATTERNS=
REDACTION_REDACT_EMAILS=false

# --- SSE ----------------------------------------------------------------------
SSE_MAX_CONNECTIONS=500
SSE_HEARTBEAT_SECONDS=15

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- Optional OTLP observability ----------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# OTEL_SERVICE_NAME=prompt-logger
